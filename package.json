{
  "name": "masterplan",
  "version": "0.1.0",
  "private": true,
  "description": "MasterPlan: plan big private events with helpers who answer by link",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:docker": "node --import tsx seed/docker-start.ts",
    "seed": "tsx seed/run.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "cookie-session": "2.1.1",
    "drizzle-orm": "0.45.4",
    "ejs": "7.0.2",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-session": "2.0.49",
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
