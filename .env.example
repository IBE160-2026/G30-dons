# MasterPlan settings. Copy to .env for local development.
# Safe defaults: test mode on, local SQLite file, no email sent.

# Test mode: no email leaves the machine, test controls available. Must be false when deployed.
TEST_MODE=true

# Port the server listens on.
PORT=3000

# Database. A file: path is local SQLite; a libsql:// URL is Turso.
DATABASE_URL=file:./data/local.db
# Required only when DATABASE_URL is not a file: path.
DATABASE_AUTH_TOKEN=

# Signs the session cookie. With TEST_MODE=false it must be a random value of at least 32 characters,
# for example from: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=local-dev-secret-change-me

# Base URL used in helper and reminder links. Defaults to http://localhost:PORT in test mode.
APP_BASE_URL=

# How email leaves the app when TEST_MODE=false. Only "disabled" is supported so far.
MAIL_TRANSPORT=disabled
