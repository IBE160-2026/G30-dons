<%- include('partials/helper-top') %>
<header class="helper-header">
  <p class="helper-brand">MasterPlan</p>
  <h1><%= reminderView ? 'Oppgaver du har sagt ja til' : header %></h1>
  <p class="helper-greeting"><%= greeting %></p>
</header>
<% if (notice) { %>
  <% if (notice.error) { %>
    <p class="flash form-error" role="alert"><%= notice.text %></p>
  <% } else { %>
    <p class="flash" role="status"><%= notice.text %></p>
  <% } %>
<% } %>
<% if (waiting) { %>
  <p class="answer-banner"><%= waiting %></p>
<% } %>
<% if (page.events.length === 0) { %>
  <% if (reminderView) { %>
    <p class="empty-state"><span class="empty-state-title">Alt er gjort!</span>Du har ingen oppgaver som venter på deg nå.</p>
  <% } else { %>
    <p class="empty-state">Du har ingen oppgaver ennå.</p>
  <% } %>
<% } %>
<% for (const event of page.events) { %>
  <section class="helper-event">
    <h2><%= event.name %> <span class="muted helper-event-date"><%= formatDate(event.eventDate) %></span></h2>
    <ul class="helper-tasks">
      <% for (const task of event.tasks) { %>
        <% if (task.status === 'done') { %>
          <li class="helper-card-done">
            <p class="helper-task-title"><%= task.title %></p>
            <span class="pill helper-status status-done"><%= statusTexts.done %></span>
            <span class="helper-deadline">Frist <%= formatDate(task.deadline) %></span>
          </li>
        <% } else { %>
          <% const unanswered = task.status === 'open'; %>
          <li class="helper-card<%= unanswered ? ' helper-card-open' : '' %>">
            <% if (unanswered) { %>
              <p class="answer-label"><%= statusTexts.open %></p>
            <% } %>
            <% if (task.changedSinceAnswer) { %>
              <p class="helper-changed">Endret etter at du svarte</p>
            <% } %>
            <p class="helper-task-title"><%= task.title %></p>
            <p class="helper-deadline">Frist <%= formatDate(task.deadline) %></p>
            <% if (!unanswered) { %>
              <span class="pill helper-status status-<%= task.status %>"><%= statusTexts[task.status] %></span>
            <% } %>
            <% if (task.actions.length > 0) { %>
              <form method="post" action="<%= paths.helperTask(page.token, task.id) %>" class="helper-form">
                <details class="message-box">
                  <summary>Legg ved en melding (valgfritt)</summary>
                  <label for="message-<%= task.id %>">Melding</label>
                  <textarea id="message-<%= task.id %>" name="message" rows="2" maxlength="<%= maxMessageLength %>"></textarea>
                </details>
                <div class="helper-actions">
                  <% for (const action of task.actions) { %>
                    <button type="submit" class="helper-button helper-button-<%= action %>" name="action" value="<%= action %>"><%= actionLabels[action] %></button>
                  <% } %>
                </div>
              </form>
            <% } %>
          </li>
        <% } %>
      <% } %>
    </ul>
  </section>
<% } %>
<% if (reminderView) { %>
  <p class="helper-all-link"><a href="<%= paths.helperPage(page.token) %>">Se alle oppgavene dine</a></p>
<% } %>
<%- include('partials/bottom') %>
