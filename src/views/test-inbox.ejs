<%- include('partials/top', { title: 'Testinnboks' }) %>
<section class="card">
  <h1>Testinnboks</h1>
  <p class="muted">E-poster appen ville sendt. Ingen e-post forlater maskinen.</p>
  <form method="post" action="<%= paths.runReminders() %>" class="test-inbox-actions">
    <button type="submit">Send påminnelser nå</button>
  </form>
  <% if (emails.length === 0) { %>
    <p class="muted">Ingen e-poster ennå. Klikk «Send påminnelser nå» for å sende påminnelser som har forfalt.</p>
  <% } else { %>
    <ul class="outbox-list">
      <% for (const email of emails) { %>
        <li class="outbox-email">
          <h2><%= email.subject %></h2>
          <p class="muted outbox-meta">Fra: <%= email.fromName %> (svar går til <%= email.replyTo %>)<br>Til: <%= email.to %><br><%= email.sentAtText %></p>
          <p class="outbox-text"><%= email.text %></p>
          <% if (email.links.length > 0) { %>
            <ul class="outbox-links">
              <% for (const link of email.links) { %>
                <li><a href="<%= link %>"><%= link %></a></li>
              <% } %>
            </ul>
          <% } %>
        </li>
      <% } %>
    </ul>
  <% } %>
</section>
<%- include('partials/bottom') %>
