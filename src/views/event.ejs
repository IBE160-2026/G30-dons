<%- include('partials/top', { title: event.name }) %>
<%- include('partials/event-tabs') %>
<%
  const blank = (v) => (v === null || v === undefined || v === '' ? '–' : v);
  const add = typeof locals.add !== 'undefined' ? locals.add : { values: {}, errors: {} };
  const edit = typeof locals.edit !== 'undefined' ? locals.edit : undefined;
  const helperForm = typeof locals.helperForm !== 'undefined' ? locals.helperForm : { values: {}, errors: {} };
%>
<div class="event-layout">
  <div class="side">
  <section class="card info-box">
    <h1><%= event.name %></h1>
    <dl>
      <dt>Når</dt><dd><%= formatDate(event.eventDate) %></dd>
      <dt>Hva</dt><dd><%= blank(event.occasion) %></dd>
      <dt>Hvor</dt><dd><%= blank(event.location) %></dd>
      <dt>Antall gjester</dt><dd><%= blank(event.guestCount) %></dd>
      <dt>Hva må gjøres</dt><dd class="pre"><%= blank(event.todo) %></dd>
      <dt>Annen informasjon</dt><dd class="pre"><%= blank(event.otherInfo) %></dd>
    </dl>
  </section>

  <section class="card helpers">
    <h2>Hjelpere (<%= helpers.length %> av <%= maxHelpers %>)</h2>
    <% if (helpers.length === 0) { %>
      <p class="muted">Ingen hjelpere ennå.</p>
    <% } %>
    <ul class="helper-list">
      <% for (const helper of helpers) { %>
        <li class="helper">
          <span class="helper-name"><%= helper.name %></span>
          <div class="copy-row">
            <label class="visually-hidden" for="link-<%= helper.id %>">Lenke til <%= helper.name %></label>
            <input id="link-<%= helper.id %>" type="text" class="link-field" value="<%= helper.link %>" readonly>
            <button type="button" class="small" data-copy="link-<%= helper.id %>" aria-live="polite">Kopier lenke</button>
          </div>
        </li>
      <% } %>
    </ul>

    <% if (helpers.length < maxHelpers || Object.keys(helperForm.errors).length > 0) { %>
      <h3>Legg til hjelper</h3>
      <form method="post" action="<%= paths.helpers(event.id) %>" class="helper-form" novalidate>
        <label for="helper-email">E-post</label>
        <input id="helper-email" name="email" type="email" maxlength="254" value="<%= helperForm.values.email || '' %>" required>
        <% if (helperForm.errors.email) { %><p class="field-error"><%= helperForm.errors.email %></p><% } %>
        <label for="helper-name">Navn (valgfritt)</label>
        <input id="helper-name" name="name" type="text" maxlength="100" value="<%= helperForm.values.name || '' %>">
        <% if (helperForm.errors.name) { %><p class="field-error"><%= helperForm.errors.name %></p><% } %>
        <button type="submit" class="small">Legg til hjelper</button>
      </form>
    <% } %>
  </section>
  </div>

  <section class="card tasks">
    <h2>Oppgaver (<%= tasks.length %>)</h2>
    <% if (tasks.length === 0) { %>
      <p class="muted">Ingen oppgaver ennå.</p>
    <% } %>
    <ul class="task-list">
      <% for (const task of tasks) {
           const editing = edit && edit.taskId === task.id;
           const v = editing ? edit.values : { title: task.title, deadline: task.deadline };
           const errs = editing ? edit.errors : {}; %>
        <li class="task">
          <form method="post" action="<%= paths.task(event.id, task.id) %>" class="task-form" novalidate>
            <label class="visually-hidden" for="title-<%= task.id %>">Oppgave</label>
            <input id="title-<%= task.id %>" name="title" type="text" maxlength="120" value="<%= v.title %>" required>
            <label class="visually-hidden" for="deadline-<%= task.id %>">Frist</label>
            <input id="deadline-<%= task.id %>" name="deadline" type="date" value="<%= v.deadline %>" required>
            <button type="submit" class="small">Lagre</button>
          </form>
          <form method="post" action="<%= paths.deleteTask(event.id, task.id) %>" class="inline">
            <button type="submit" class="small secondary">Slett</button>
          </form>
          <% if (task.status !== 'done') { %>
            <form method="post" action="<%= paths.markDone(event.id, task.id) %>" class="inline">
              <button type="submit" class="small">Marker som ferdig</button>
            </form>
          <% } %>
          <p class="task-meta muted">
            Frist <%= formatDate(task.deadline) %> · <span class="status status-<%= task.status %>"><%= statusLabels[task.status] %></span><% if (task.helperId !== null && helperNames[task.helperId]) { %> · <%= helperNames[task.helperId] %><% } %>
          </p>
          <% if (helpers.length > 0) { %>
            <form method="post" action="<%= paths.assignTask(event.id, task.id) %>" class="assign-form">
              <label class="visually-hidden" for="assign-<%= task.id %>">Hjelper</label>
              <select id="assign-<%= task.id %>" name="helperId" required>
                <% if (task.helperId === null) { %><option value="" selected disabled>Velg hjelper</option><% } %>
                <% for (const helper of helpers) { %>
                  <option value="<%= helper.id %>"<%= task.helperId === helper.id ? ' selected' : '' %>><%= helper.name %></option>
                <% } %>
              </select>
              <button type="submit" class="small">Tildel</button>
            </form>
          <% } %>
          <% if (errs.title) { %><p class="field-error"><%= errs.title %></p><% } %>
          <% if (errs.deadline) { %><p class="field-error"><%= errs.deadline %></p><% } %>
        </li>
      <% } %>
    </ul>

    <h3>Ny oppgave</h3>
    <form method="post" action="<%= paths.tasks(event.id) %>" class="task-form" novalidate>
      <label class="visually-hidden" for="new-title">Oppgave</label>
      <input id="new-title" name="title" type="text" maxlength="120" placeholder="Hva skal gjøres?" value="<%= add.values.title || '' %>" required>
      <label class="visually-hidden" for="new-deadline">Frist</label>
      <input id="new-deadline" name="deadline" type="date" min="<%= today %>" value="<%= add.values.deadline || '' %>" required>
      <button type="submit" class="small">Legg til</button>
    </form>
    <% if (add.errors.title) { %><p class="field-error"><%= add.errors.title %></p><% } %>
    <% if (add.errors.deadline) { %><p class="field-error"><%= add.errors.deadline %></p><% } %>
  </section>
</div>
<script src="/copy.js" defer></script>
<%- include('partials/bottom') %>
