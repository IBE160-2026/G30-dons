<%- include('partials/top', { title: event.name }) %>
<%- include('partials/event-tabs') %>
<%
  const blank = (v) => (v === null || v === undefined || v === '' ? '–' : v);
  const errorAttrs = (id, error, focus) =>
    error ? ` aria-describedby="${id}-error"${focus ? ' autofocus' : ''}` : '';
%>
<div class="event-head">
  <h1><%= event.name %></h1>
  <dl class="event-facts">
    <dt>Når</dt><dd><%= formatDate(event.eventDate) %> · <%= daysText %></dd>
    <dt>Hvor</dt><dd><%= blank(event.location) %></dd>
    <dt>Antall gjester</dt><dd><%= blank(event.guestCount) %></dd>
  </dl>
  <details class="event-details">
    <summary>Vis alle detaljer</summary>
    <dl class="event-facts">
      <dt>Hva</dt><dd><%= blank(event.occasion) %></dd>
      <dt>Hva må gjøres</dt><dd class="pre"><%= blank(event.todo) %></dd>
      <dt>Annen informasjon</dt><dd class="pre"><%= blank(event.otherInfo) %></dd>
    </dl>
  </details>
</div>

<div class="event-layout">
  <div class="event-main">
    <% if (needsYou.length > 0) { %>
      <section class="card card-action" aria-labelledby="needs-you-title">
        <div class="card-head">
          <h2 id="needs-you-title">Trenger deg nå</h2>
          <span class="card-meta"><%= attentionText %></span>
        </div>
        <ul class="row-list">
          <% for (const t of needsYou) { %>
            <li class="needs-row">
              <p class="row-line">
                <span class="task-title"><%= t.title %></span>
                <span class="pill <%= t.pill.className %>"><%= t.pill.text %></span>
                <span class="row-meta">Frist <%= formatDate(t.deadline) %></span>
              </p>
              <% if (t.message) { %><p class="needs-message">«<%= t.message %>»</p><% } %>
              <div class="row-actions">
                <% if (t.delegate) { %>
                  <% if (helperOptions.length === 0) { %>
                    <p class="row-meta">Legg til en hjelper først</p>
                  <% } else { %>
                    <form method="post" action="<%= paths.assignTask(event.id, t.id) %>" class="assign-form">
                      <input type="hidden" name="fra" value="trenger">
                      <label class="visually-hidden" for="needs-assign-<%= t.id %>">Hjelper for <%= t.title %></label>
                      <select id="needs-assign-<%= t.id %>" name="helperId"<%- errorAttrs(`needs-assign-${t.id}`, t.error, true) %>>
                        <option value="" selected disabled>Velg hjelper</option>
                        <% for (const h of helperOptions) { %><option value="<%= h.id %>"><%= h.name %></option><% } %>
                      </select>
                      <button type="submit" class="small">Gi oppgaven</button>
                    </form>
                    <% if (t.error) { %><p class="field-error" id="needs-assign-<%= t.id %>-error"><%= t.error %></p><% } %>
                  <% } %>
                <% } %>
                <form method="post" action="<%= paths.markDone(event.id, t.id) %>" class="inline">
                  <button type="submit" class="<%= t.delegate ? 'button-quiet' : 'button-secondary small' %>">Marker som ferdig</button>
                </form>
              </div>
            </li>
          <% } %>
        </ul>
      </section>
    <% } %>

    <section class="card card-framed fremdrift" aria-labelledby="progress-title">
      <div class="card-head">
        <h2 id="progress-title">Fremdrift</h2>
        <span class="card-meta"><%= progress.done %> av <%= progress.total %> ferdig</span>
      </div>
      <% if (needsYou.length === 0) { %><p class="calm-line">Ingenting trenger deg akkurat nå.</p><% } %>
      <progress value="<%= progress.done %>" max="<%= progress.total || 1 %>" aria-label="<%= progress.done %> av <%= progress.total %> oppgaver ferdig"><%= progress.done %> av <%= progress.total %></progress>
      <% if (progress.groupCounts.length > 0) { %>
        <ul class="count-pills">
          <% for (const g of progress.groupCounts) { %><li class="pill <%= g.className %>"><%= g.count %> <%= g.label %></li><% } %>
        </ul>
      <% } %>
      <div class="week-groups">
        <% for (const [label, week] of [['Denne uka', progress.thisWeek], ['Neste uke', progress.nextWeek]]) { %>
          <div class="week">
            <h3 class="label-caps"><%= label %></h3>
            <% if (week.length === 0) { %>
              <p class="row-meta">Ingen frister</p>
            <% } %>
            <% for (const day of week) { %>
              <p class="day-label"><%= day.label %></p>
              <ul class="row-list">
                <% for (const t of day.tasks) { %>
                  <li class="week-row"><span class="task-title"><%= t.title %></span> <span class="pill <%= t.pill.className %>"><%= t.pill.text %></span></li>
                <% } %>
              </ul>
            <% } %>
          </div>
        <% } %>
      </div>
    </section>
  </div>

  <div class="event-side">
    <section class="card card-collapsible" aria-labelledby="helpers-title">
      <details class="collapsible" id="helpers-card"<%= helpersOpen ? ' open' : '' %>>
        <summary><span class="collapsible-title" id="helpers-title">Hjelpere</span> <span class="collapsible-meta"><%= helpers.length %> av <%= maxHelpers %></span></summary>
        <% if (helpers.length === 0) { %>
          <p class="row-meta">Ingen hjelpere ennå.</p>
        <% } %>
        <ul class="row-list">
          <% for (const h of helpers) { %>
            <li class="helper-row">
              <span class="avatar" aria-hidden="true"><%= h.initial %></span>
              <span class="helper-info">
                <span class="helper-name"><%= h.name %></span>
                <span class="row-meta"><%= h.summary %></span>
              </span>
              <button type="button" class="button-secondary small" data-copy="link-<%= h.id %>">Kopier lenke</button>
              <details class="link-details">
                <summary>Vis lenken</summary>
                <label class="visually-hidden" for="link-<%= h.id %>">Lenke til <%= h.name %></label>
                <input id="link-<%= h.id %>" type="text" class="link-field" value="<%= h.link %>" readonly>
              </details>
            </li>
          <% } %>
        </ul>
        <p class="copy-status" id="copy-status" role="status"></p>
        <% if (helpers.length < maxHelpers || Object.keys(helperForm.errors).length > 0) { %>
          <details class="add-helper"<%= helpers.length === 0 || Object.keys(helperForm.errors).length > 0 ? ' open' : '' %>>
            <summary>+ Legg til hjelper</summary>
            <form method="post" action="<%= paths.helpers(event.id) %>" class="stacked-form" novalidate>
              <label for="helper-email">E-post</label>
              <input id="helper-email" name="email" type="email" maxlength="254" value="<%= helperForm.values.email || '' %>" required<%- errorAttrs('helper-email', helperForm.errors.email, true) %>>
              <% if (helperForm.errors.email) { %><p class="field-error" id="helper-email-error"><%= helperForm.errors.email %></p><% } %>
              <label for="helper-name">Navn (valgfritt)</label>
              <input id="helper-name" name="name" type="text" maxlength="100" value="<%= helperForm.values.name || '' %>"<%- errorAttrs('helper-name', helperForm.errors.name, !helperForm.errors.email) %>>
              <% if (helperForm.errors.name) { %><p class="field-error" id="helper-name-error"><%= helperForm.errors.name %></p><% } %>
              <button type="submit" class="small">Legg til hjelper</button>
            </form>
          </details>
        <% } %>
      </details>
    </section>

    <section class="card" aria-labelledby="messages-title">
      <div class="card-head">
        <h2 id="messages-title">Meldinger</h2>
        <span class="card-meta"><%= messages.newRepliesText %></span>
      </div>
      <% const listed = messages.all ?? messages.preview; %>
      <% if (listed.length === 0) { %>
        <p class="empty-state"><span class="empty-state-title"><%= messages.all ? 'Ingen svar ennå' : 'Ingen nye svar ennå' %></span>Svar fra hjelperne dukker opp her.</p>
      <% } %>
      <ul class="row-list">
        <% for (const r of listed) { %>
          <li class="reply">
            <p class="reply-head">
              <% if (r.isNew) { %><span class="badge">Ny</span><% } %>
              <strong><%= r.helperName %></strong> · <%= r.taskTitle %> · <span class="reply-action"><%= r.actionLabel %></span>
            </p>
            <% if (r.body) { %><p class="reply-body pre"><%= r.body %></p><% } %>
            <p class="row-meta"><%= r.time %></p>
          </li>
        <% } %>
      </ul>
      <% if (messages.all) { %>
        <a href="<%= paths.event(event.id) %>">Skjul svar</a>
      <% } else { %>
        <a href="<%= paths.eventMessages(event.id) %>">Vis alle svar</a>
      <% } %>
    </section>
  </div>

  <div class="event-tasks">
    <section class="card card-collapsible" aria-labelledby="tasks-title">
      <details class="collapsible" id="tasks-card"<%= tasksOpen ? ' open' : '' %>>
        <summary><span class="collapsible-title" id="tasks-title">Alle oppgaver</span> <span class="collapsible-meta"><%= taskCount %> · <%= doneCount %> ferdig</span></summary>
        <% if (taskGroups.length === 0) { %>
          <p class="empty-state"><span class="empty-state-title">Ingen oppgaver her ennå</span>Legg til den første oppgaven.</p>
        <% } %>
        <% for (const group of taskGroups) { %>
          <h3 class="label-caps"><%= group.label %></h3>
          <ul class="row-list">
            <% for (const t of group.tasks) {
                 const box = editBox && editBox.taskId === t.id ? editBox : null; %>
              <li class="task-row<%= t.done ? ' task-row-done' : '' %>" id="task-<%= t.id %>">
                <p class="row-line">
                  <span class="task-title"><%= t.title %></span>
                  <span class="pill <%= t.pill.className %>"><%= t.pill.text %></span>
                  <span class="row-meta">Frist <%= formatDate(t.deadline) %></span>
                  <% if (box) { %>
                    <a class="button-quiet" href="<%= paths.event(event.id) %>#task-<%= t.id %>">Lukk</a>
                  <% } else { %>
                    <a class="button-quiet" href="<%= paths.event(event.id) %>?endre=<%= t.id %>#task-<%= t.id %>">Endre</a>
                  <% } %>
                </p>
                <% if (box) { %>
                  <div class="edit-box" id="edit-<%= t.id %>">
                    <form method="post" action="<%= paths.task(event.id, t.id) %>" class="stacked-form" novalidate>
                      <label for="title-<%= t.id %>">Oppgave</label>
                      <input id="title-<%= t.id %>" name="title" type="text" maxlength="120" value="<%= box.values.title %>" required<%- errorAttrs(`title-${t.id}`, box.errors.title, true) %>>
                      <% if (box.errors.title) { %><p class="field-error" id="title-<%= t.id %>-error"><%= box.errors.title %></p><% } %>
                      <label for="deadline-<%= t.id %>">Frist</label>
                      <input id="deadline-<%= t.id %>" name="deadline" type="date" value="<%= box.values.deadline %>" required<%- errorAttrs(`deadline-${t.id}`, box.errors.deadline, !box.errors.title) %>>
                      <% if (box.errors.deadline) { %><p class="field-error" id="deadline-<%= t.id %>-error"><%= box.errors.deadline %></p><% } %>
                      <button type="submit" class="small">Lagre</button>
                    </form>
                    <form method="post" action="<%= paths.assignTask(event.id, t.id) %>" class="stacked-form">
                      <label for="assign-<%= t.id %>">Hjelper</label>
                      <% if (helperOptions.length === 0) { %>
                        <p class="row-meta">Legg til en hjelper først</p>
                      <% } else { %>
                        <select id="assign-<%= t.id %>" name="helperId"<%- errorAttrs(`assign-${t.id}`, box.errors.helperId, true) %>>
                          <% if (t.helperId === null) { %><option value="" selected disabled>Velg hjelper</option><% } %>
                          <% for (const h of helperOptions) { %>
                            <option value="<%= h.id %>"<%= t.helperId === h.id ? ' selected' : '' %>><%= h.name %></option>
                          <% } %>
                        </select>
                        <% if (box.errors.helperId) { %><p class="field-error" id="assign-<%= t.id %>-error"><%= box.errors.helperId %></p><% } %>
                        <button type="submit" class="button-secondary small">Gi oppgaven</button>
                      <% } %>
                    </form>
                    <div class="row-actions">
                      <% if (!t.done) { %>
                        <form method="post" action="<%= paths.markDone(event.id, t.id) %>" class="inline">
                          <button type="submit" class="button-secondary small">Marker som ferdig</button>
                        </form>
                      <% } %>
                      <form method="post" action="<%= paths.deleteTask(event.id, t.id) %>" class="inline">
                        <button type="submit" class="button-danger small">Slett oppgaven</button>
                      </form>
                      <a href="<%= paths.event(event.id) %>#task-<%= t.id %>">Avbryt</a>
                    </div>
                  </div>
                <% } %>
              </li>
            <% } %>
          </ul>
        <% } %>
      </details>
    </section>

    <section class="card" aria-labelledby="new-task-title">
      <h2 id="new-task-title">Ny oppgave</h2>
      <form method="post" action="<%= paths.tasks(event.id) %>" class="task-form" novalidate>
        <label class="visually-hidden" for="new-title">Oppgave</label>
        <input id="new-title" name="title" type="text" maxlength="120" placeholder="Hva skal gjøres?" value="<%= add.values.title || '' %>" required<%- errorAttrs('new-title', add.errors.title, true) %>>
        <label class="visually-hidden" for="new-deadline">Frist</label>
        <input id="new-deadline" name="deadline" type="date" min="<%= today %>" value="<%= add.values.deadline || '' %>" required<%- errorAttrs('new-deadline', add.errors.deadline, !add.errors.title) %>>
        <button type="submit" class="small">Legg til</button>
      </form>
      <% if (add.errors.title) { %><p class="field-error" id="new-title-error"><%= add.errors.title %></p><% } %>
      <% if (add.errors.deadline) { %><p class="field-error" id="new-deadline-error"><%= add.errors.deadline %></p><% } %>
    </section>
  </div>
</div>
<script src="/copy.js" defer></script>
<%- include('partials/bottom') %>
