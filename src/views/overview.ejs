<%- include('partials/top', { title: 'Oversikt' }) %>
<section class="card">
  <div class="heading-row">
    <h1>Oversikt</h1>
    <a class="button" href="<%= paths.newEvent() %>">Nytt arrangement</a>
  </div>
  <p>Hei, <%= organizer.name %>!</p>
  <% if (events.length === 0) { %>
    <p class="muted">Du har ingen arrangementer ennå.</p>
  <% } else { %>
    <ul class="event-list">
      <% for (const event of events) { %>
        <li class="overview-row">
          <div class="overview-event">
            <a href="<%= paths.event(event.id) %>"><%= event.name %></a>
            <span class="muted"><%= formatDate(event.eventDate) %></span>
          </div>
          <div class="overview-status">
            <span class="attention attention-<%= event.state %>"><%= event.statusText %></span>
            <% if (event.newRepliesText) { %><span class="badge"><%= event.newRepliesText %></span><% } %>
          </div>
        </li>
      <% } %>
    </ul>
  <% } %>
</section>
<%- include('partials/bottom') %>
