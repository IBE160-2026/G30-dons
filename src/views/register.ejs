<%- include('partials/top', { title: 'Opprett konto' }) %>
<section class="card narrow">
  <h1>Opprett konto</h1>
  <form method="post" action="<%= paths.register() %>" novalidate>
    <label for="name">Navn</label>
    <input id="name" name="name" type="text" autocomplete="name" value="<%= values.name || '' %>" required>
    <% if (errors.name) { %><p class="field-error"><%= errors.name %></p><% } %>

    <label for="email">E-post</label>
    <input id="email" name="email" type="email" autocomplete="email" value="<%= values.email || '' %>" required>
    <% if (errors.email) { %><p class="field-error"><%= errors.email %></p><% } %>

    <label for="password">Passord (minst 8 tegn)</label>
    <input id="password" name="password" type="password" autocomplete="new-password" required>
    <% if (errors.password) { %><p class="field-error"><%= errors.password %></p><% } %>

    <button type="submit">Opprett konto</button>
  </form>
  <p>Har du allerede en konto? <a href="<%= paths.login() %>">Logg inn</a></p>
</section>
<%- include('partials/bottom') %>
